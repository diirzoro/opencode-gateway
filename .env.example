# Copy to .env, restrict it to the service account, and replace the password.
DATABASE_URL=postgresql+psycopg://opencode_gateway:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@127.0.0.1:5432/opencode_gateway
SESSION_COOKIE_NAME=gateway_session
SESSION_DAYS=14
COOKIE_SECURE=true
APP_HOST=127.0.0.1
APP_PORT=8000
